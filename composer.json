{
    "name": "lbonnet/seo-bundle",
    "type": "symfony-bundle",
    "description": "A Symfony bundle that crawls a site once to audit its links, on-page content and technical SEO signals: broken links, titles and descriptions, canonical tags, indexing directives, redirects, robots.txt, sitemaps and hreflang.",
    "keywords": [
        "symfony",
        "bundle",
        "seo",
        "audit",
        "crawler",
        "link-checker",
        "broken-links",
        "on-page-seo",
        "technical-seo",
        "canonical",
        "hreflang",
        "sitemap",
        "robots-txt"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "lbonnet",
            "homepage": "https://github.com/lbonnet-gda"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-xmlreader": "*",
        "ext-zlib": "*",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/lock": "^6.4 || ^7.0 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.0 || ^8.0",
        "symfony/polyfill-mbstring": "^1.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/phpunit-bridge": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "symfony/notifier": "To send alerts (Slack, email, ...) from a SeoAuditCompletedEvent listener.",
        "symfony/scheduler": "To run periodic audits via a RecurringMessage, as shown in the README."
    },
    "autoload": {
        "psr-4": {
            "Lbonnet\\SeoBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lbonnet\\SeoBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
